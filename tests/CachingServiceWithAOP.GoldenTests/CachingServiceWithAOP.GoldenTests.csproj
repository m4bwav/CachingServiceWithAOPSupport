<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The golden replay (plan D1): the Phase 0 capture's cases, compiled unchanged against 2.x and compared with what the
    published 1.0.1 answered on .NET Framework 4.8. In a project of its own so no other test shares its process
    (skill L-072 golden-alone-in-process: MemoryCache.Default and the call counters are process-wide).
  -->

  <PropertyGroup>
    <TargetFrameworks>net10.0;net48</TargetFrameworks>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- A locked-mode lock file must not depend on what the SDK infers per OS (the NuGet reference's trap). -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- Frozen since the Phase 0 commit 348da5d; never edit them to make a test pass. -->
    <Compile Include="../Golden/Capture/Cases.cs" Link="Capture/Cases.cs" />
    <Compile Include="../Golden/Capture/Fixtures.cs" Link="Capture/Fixtures.cs" />
    <Compile Include="../Golden/Capture/Json.cs" Link="Capture/Json.cs" />
    <None Include="../Golden/1.0.1.net48-windows.json" Link="Golden/1.0.1.net48-windows.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="System.Text.Json" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/CachingServiceWithAOP/CachingServiceWithAOP.csproj" />
  </ItemGroup>

</Project>
